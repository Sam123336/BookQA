# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider - set ONE of these. OpenAI wins if both are present.
OPENAI_API_KEY=sk-your-openai-api-key
# GEMINI_API_KEY=AIza-your-gemini-api-key

# Optional: Groq for ANSWERS ONLY. Groq has no /embeddings endpoint, so it takes
# over chat while embeddings keep coming from the OpenAI or Gemini key above -
# one of those two must stay set or ingestion has nothing to make vectors with.
# GROQ_API_KEY=gsk_your-groq-api-key

# Optional: force the chat provider ('openai' | 'gemini' | 'groq').
# Embedding ignores this and always picks a provider that can embed.
# AI_PROVIDER=gemini

# Optional model overrides
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_LLM_MODEL=gpt-4o-mini
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Free-tier request quotas are PER MODEL. On a 429, switch this rather than
# waiting - gemini-3.1-flash-lite and gemini-flash-lite-latest have more headroom.
# GEMINI_LLM_MODEL=gemini-3.5-flash
# GROQ_LLM_MODEL=openai/gpt-oss-120b

# Limits for large books (300+ pages)
# MAX_UPLOAD_BYTES=209715200      # 200MB
# EMBEDDING_MAX_RETRIES=8         # background ingestion waits out rate limits
# LLM_MAX_RETRIES=5               # a person is waiting, so give up sooner
# RETRY_MAX_DELAY_MS=60000        # cap on how long a provider's retry hint is honoured

# RAG Configuration Defaults
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=50
TOP_K=6
# MIN_SIMILARITY=  # unset: uses the per-provider default in lib/ai/provider.ts
